# Copiar este archivo como .env y completar los valores (el .env NO se sube a git)

# Conexión a PostgreSQL: postgres://usuario:contraseña@host:puerto/base
DATABASE_URL=postgres://postgres:CAMBIAR@localhost:5432/postgres
# true solo para bases en la nube que exigen SSL
DATABASE_SSL=false

# Contraseña de la cuenta demo (la usa npm run db:seed)
DEMO_PASSWORD=CAMBIAR

# Puerto del servidor
PORT=3000

# Clave para firmar los tokens: un texto largo y aleatorio
JWT_SECRET=CAMBIAR
JWT_EXPIRES_IN=7d

# URL del frontend (para CORS)
FRONTEND_URL=http://localhost:5173
